{
  "name": "opencode-harness-kit",
  "version": "0.3.3",
  "description": "Harness kit for OpenCode: capability profiles, a fleet of job lanes with one free model each, role-based reasoning effort, context pruning, and measured baselines.",
  "license": "MIT",
  "homepage": "https://github.com/pham-canh/space-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pham-canh/space-harness.git"
  },
  "bugs": {
    "url": "https://github.com/pham-canh/space-harness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./profile": "./src/profile.js",
    "./config": "./src/config.js",
    "./rules": "./src/rules.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "oc-harness": "bin/oc-harness.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "profiles/",
    "prompts/",
    "skills/",
    "docs/*.md",
    "retention.yml",
    "lanes.json",
    "lanes.schema.json",
    "GLOBAL.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\"",
    "test:all": "npm run build && npm run typecheck && npm test",
    "test:install": "npm run measure:check && npm run attribute",
    "check": "npm run test:all && npm run test:install && node bin/oc-harness.mjs verify",
    "check:online": "npm run check && node bin/oc-harness.mjs doctor",
    "baseline": "node bin/baseline.mjs",
    "eval": "node eval/run.mjs",
    "measure": "node eval/measure-install.mjs",
    "measure:check": "node eval/measure-install.mjs --min-narrow 45 --min-ctx-drop 20",
    "attribute": "node eval/attribute.mjs",
    "attribute:json": "node eval/attribute.mjs --json",
    "thresholds": "node eval/thresholds.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "harness",
    "context-management",
    "reasoning-effort"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
