{
  "name": "opencode-harness-kit",
  "version": "0.6.3",
  "description": "Harness kit for OpenCode: capability profiles, a fleet of job lanes with one free model each, role-based reasoning effort, context pruning, and measured baselines.",
  "license": "MIT",
  "homepage": "https://github.com/pham-canh/opencode-harness-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pham-canh/opencode-harness-kit.git"
  },
  "bugs": {
    "url": "https://github.com/pham-canh/opencode-harness-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./src/config.js"
    },
    "./denylist": {
      "types": "./dist/denylist.d.ts",
      "import": "./src/denylist.js"
    },
    "./lanes.schema.json": "./lanes.schema.json",
    "./package.json": "./package.json",
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./src/profile.js"
    },
    "./profiles/schema.json": "./profiles/schema.json",
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./src/rules.js"
    }
  },
  "bin": {
    "oc-harness": "bin/oc-harness.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "profiles/",
    "prompts/",
    "skills/",
    "docs/*.md",
    "retention.yml",
    "lanes.json",
    "lanes.schema.json",
    "GLOBAL.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "eval/"
  ],
  "scripts": {
    "build": "npm run build:types && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "typecheck": "tsc --noEmit && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "pretest": "node -e \"const fs=require('fs');if(!fs.existsSync('test')){console.error('no test directory here - this is an installed package, not a checkout');process.exit(1)}\"",
    "test": "node --test \"test/*.test.js\"",
    "test:all": "npm run build && npm run typecheck && npm test",
    "test:dist": "git diff --exit-code -- dist/ || (echo \"dist/ is out of sync with src/. Run: npm run build && git add dist/\" && exit 1)",
    "check": "npm run build && npm run test:dist && npm run typecheck && npm test",
    "test:install": "npm run measure:check && npm run attribute",
    "check:install": "npm run test:all && npm run test:install && node bin/oc-harness.mjs verify",
    "check:online": "npm run check:install && node bin/oc-harness.mjs doctor",
    "doctor": "node bin/oc-harness.mjs doctor",
    "baseline": "node bin/baseline.mjs",
    "release:trust": "node bin/oc-harness.mjs trust",
    "eval": "node eval/run.mjs",
    "measure": "node eval/measure-install.mjs",
    "measure:prune": "node eval/measure-prune.mjs --sessions 60 --days 30 --min-saved 20",
    "measure:check": "npm run measure:prune && node eval/measure-install.mjs --min-narrow 45 --min-ctx-drop 20",
    "attribute": "node eval/attribute.mjs",
    "attribute:json": "node eval/attribute.mjs --json",
    "thresholds": "node eval/thresholds.mjs",
    "prepublishOnly": "npm run build",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "harness",
    "context-management",
    "reasoning-effort"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "pham-canh"
}
