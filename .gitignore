node_modules/
.DS_Store
*.log

# Credentials. Never commit these, and never let `git add .` sweep them up.
.env
.env.*
.evn
.npmrc
.netrc
.git-credentials

# Local measurement output. The script ships; your numbers stay local.
baseline-*.json
baseline-*.txt
coverage/
.space/

# `.space/` is scratch state, with two exceptions that are data the tests read:
# the worked examples, and the template golden snapshots. Without these the
# suite passes locally and fails on a fresh clone.
!examples/*/.space/
!examples/*/.space/**
!test/fixtures/templates/golden/*/files/.space/
!test/fixtures/templates/golden/*/files/.space/**

# Runtime state written by the plugin
.health.json

# eval scratch
.space-eval/

# Scratch bundle built by test/integration.test.js. The test removes it on exit,
# but the handler does not run if the process is killed, so ignore it regardless.
.test-build-*/

__pycache__/

# Video work shot with this kit: scenes, audio, renders. Output, not source.
/video/
