node_modules/
.DS_Store
*.log

# Credentials. Never commit these, and never let `git add .` sweep them up.
.env
.env.*
.evn
.npmrc
.netrc
.git-credentials

# Local measurement output. The script ships; your numbers stay local.
baseline-*.json
baseline-*.txt
.space/

# Runtime state written by the plugin
.health.json

# eval scratch
.space-eval/

# Scratch bundle built by test/integration.test.js. The test removes it on exit,
# but the handler does not run if the process is killed, so ignore it regardless.
.test-build-*/

# video build artifacts (regenerate with video/build.py)
video/scenes/
video/audio/
video/space-harness-demo.mp4
video/__pycache__/
video/build/
video/vo.m4a
video/vo_timed.txt
video/narration.m4a

# Demo tooling. tools/vrec and tools/btake carry their own .gitignore for their
# own scratch; these are the leftovers a script creates at the root of the tree.
tools/*/node_modules/
tools/*/.venv/
tools/*/__pycache__/
tools/*/out/
tools/*/frames/
tools/vrec/.repos/
